<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.est.estructurasdedatosproyecto03.ui.screen.people.PeopleBrowserController"
            prefWidth="1100.0"
            prefHeight="760.0"
            styleClass="page-root">
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16.0"
              styleClass="app-header">
            <padding>
                <Insets top="12.0" right="24.0" bottom="12.0" left="24.0"/>
            </padding>
            <children>
                <Label text="Social UNA" styleClass="brand-mark"/>
                <Button text="Inicio" styleClass="nav-item" onAction="#openTimeline"/>
                <Button text="Personas" styleClass="nav-item-active"/>
                <Label fx:id="activeNameLabel" HBox.hgrow="ALWAYS" styleClass="muted-text"/>
                <Button text="Cambiar tema"
                        styleClass="button-ghost"
                        onAction="#handleToggleTheme"/>
                <Button text="Cerrar sesión"
                        styleClass="button-ghost"
                        onAction="#handleSignOut"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="22.0" maxWidth="1000.0">
                    <padding>
                        <Insets top="28.0" right="28.0" bottom="32.0" left="28.0"/>
                    </padding>
                    <children>
                        <VBox spacing="6.0">
                            <Label text="Encuentra estudiantes" styleClass="page-title"/>
                            <Label text="Busca por nombre o nombre de usuario y agrega conexiones."
                                   wrapText="true"
                                   styleClass="muted-text"/>
                        </VBox>

                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Buscar estudiantes..."
                                           styleClass="search-field"
                                           onAction="#handleSearch"
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="Buscar"
                                        styleClass="button-primary"
                                        onAction="#handleSearch"/>
                            </children>
                        </HBox>

                        <HBox spacing="18.0" alignment="TOP_CENTER">
                            <children>
                                <VBox spacing="12.0"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="surface-card">
                                    <children>
                                        <Label text="Resultados" styleClass="section-title"/>
                                        <VBox fx:id="searchResultsContainer" spacing="10.0"/>
                                    </children>
                                </VBox>

                                <VBox spacing="12.0"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="surface-card">
                                    <children>
                                        <Label text="Mis conexiones" styleClass="section-title"/>
                                        <VBox fx:id="connectionsContainer" spacing="10.0"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
