<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="cr.ac.una.est.estructurasdedatosproyecto03.ui.screen.signin.SignInController"
           prefWidth="1000.0"
           prefHeight="720.0"
           styleClass="page-root">
    <children>
        <VBox maxWidth="430.0"
              spacing="18.0"
              styleClass="surface-card">
            <padding>
                <Insets top="30.0" right="32.0" bottom="30.0" left="32.0"/>
            </padding>
            <children>
                <Label text="Social UNA" styleClass="brand-mark"/>
                <Button text="Cambiar tema"
                        maxWidth="Infinity"
                        styleClass="button-ghost"
                        onAction="#handleToggleTheme"/>
                <Label text="Conectamos a la comunidad estudiantil"
                       wrapText="true"
                       styleClass="muted-text"/>
                <Label text="Iniciar sesión" styleClass="page-title"/>

                <VBox spacing="7.0">
                    <Label text="Usuario"/>
                    <TextField fx:id="usernameField"
                               promptText="Tu nombre de usuario"
                               onAction="#handleSignIn"/>
                </VBox>

                <VBox spacing="7.0">
                    <Label text="Contraseña"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Tu contraseña"
                                   onAction="#handleSignIn"/>
                </VBox>

                <Label fx:id="feedbackLabel"
                       wrapText="true"
                       styleClass="validation-error"/>

                <Button text="Iniciar sesión"
                        maxWidth="Infinity"
                        styleClass="button-primary"
                        onAction="#handleSignIn"/>

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="¿Aún no tienes cuenta?" styleClass="muted-text"/>
                        <Hyperlink text="Crear cuenta"
                                   styleClass="text-link"
                                   onAction="#openSignUp"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
